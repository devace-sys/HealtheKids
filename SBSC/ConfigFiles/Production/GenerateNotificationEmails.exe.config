<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7"/>
  </startup>
  <appSettings>
    <add key="newManPageSubject"    value = "New Practi-Cal Announcements and/or Help Topics"/>
    <add key="newManPageHead"       value = "{0}:"/>
    <add key="newManPageBodyStart"  value = "Practi-Cal has published new announcements or help topics in SpEdCare that you will need to review.  These announcements or help topics may be related to a change in program policy, software updates or reminders of important program tasks."/>
    <add key="newManPageBodyEnd"    value = "Please login to your SpEdCare account and review the new announcements or help Items listed above.  If you have any further questions, please contact your assigned district consultant."/>    
	<add key="appNotice" value=""/>	
    <add key="dbConnUsers" value="Data Source=SBSCSQL4\SBSCSQL4;Initial Catalog=Users;User Id=webuser;Password=plmitdb2dty9;" />
