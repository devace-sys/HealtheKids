    <add key="appContact" value="{name:'Practi-Cal, Inc.', phone:'(909) 944-7798 or (888) 944-7798', fax:'(909) 481-7410', email:'lea@practi-cal.com', mail:'PO Box 981000 West Sacramento CA 95798-1000'}"/>    
