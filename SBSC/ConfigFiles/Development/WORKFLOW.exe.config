<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7"/>
  </startup>
    
  <connectionStrings>
    
    <add name="Spedmon"
        connectionString="Data Source=LOCALHOST\SQLDEV2017;Initial Catalog=SPEDMON;User Id=webuser;Password=plmitec98;"
        providerName="System.Data.SqlClient" />
    
    <add name="Users"
        connectionString="Data Source=LOCALHOST\SQLDEV2017;Initial Catalog=USERS;User Id=webuser;Password=plmitec98;"
        providerName="System.Data.SqlClient" />  
    
  </connectionStrings>

  <system.net>

    <mailSettings>

      <smtp deliveryMethod="SpecifiedPickupDirectory">
        <specifiedPickupDirectory pickupDirectoryLocation="C:\spedmon\data\test-email\" />

        <network host="smtp.gmail.com" port="587" />

      </smtp>

    </mailSettings>

  </system.net>

  <appSettings>
    <add key="MediaFilePath"        value="C:\spedmon\data\files\help\"/> 
    <add key="MediaServiceLogPath"  value="C:\spedmon\data\logs\file-requests\"/>     
        
    <add key="basePath" value="C:\"/>
    <add key="oldPath"  value="Work Flow\"/>
    <add key="AnIPath"  value="C:\"/>
	<add key="QFormResponseFilePath"	value = "C:\spedmon\data\qform_uploads\"/>
    <add key="WFSummaryRpt" value="C:\0 Archive\z SBSC Weekly Report from E\WorkflowSummaryReports\"/>
    
    <!--Add email addresses separated by commas-->
    <add key="appEmailTo"  value="sdhanala@help4schools.com"/>
    <add key="appEmailCc"  value="sdhanala@help4schools.com"/>
    <add key="appEmailBcc" value="sdhanala@help4schools.com"/>
    <add key="appEmailSummaryRpt" value="sdhanala@help4schools.com"/>
	<add key="ChuckEmail"   value=""/>
    <add key="logFilePath"   value="C:\spedmon\data\logs\apps"/>
    
	<add key="appEmailFrom"  value="mail@practi-cal.com"/>
    <add key="appSMTPHost"   value="mail.help4schools.com"/>
    <add key="appSMTPPort"   value="25"/>
    <add key="smtpPass"      value="" />
    
<!--no-reply@practi-cal.com -->
    <add key="appQformEmailFrom"  value="no-reply@practi-cal.com"/>
    <add key="appSMTPHost"   value="mail.help4schools.com"/>
    <add key="appSMTPPort"   value="25"/>
    <add key="smtpNoReplyPass"      value="" />

	<add key="serverName"   value="localhost/spedmon/"/>

  </appSettings>
  
</configuration>
