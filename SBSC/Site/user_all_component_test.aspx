<script type="text/javascript">

let $codeSet = null;
let $results = null;

<%/**************************************************************************************************************************/%>



<%/**************************************************************************************************************************/%>

function parseCodeSet () {
    let codeSnippet = '';
    let $rows = $($codeSet).children('tr');

    $($rows).each(function (index) {
        let code = $(this).children('td.code').first().text();        
        $(this).children('td.description').children('span').remove();
         let description = $(this).children('td.description').text();
        description = description.replaceAll("'", "");
        codeSnippet += "_codeSet.set('";
        codeSnippet += code;
        codeSnippet += "','"
        codeSnippet += description;
        codeSnippet += "');"
        codeSnippet += "\n";
    });
    $($results).text(codeSnippet);
};

<%/**************************************************************************************************************************/%>



<%/**************************************************************************************************************************/%>

$(document).ready(function () {
  $codeSet = $('#codeset');
  $results = $('#results');
  parseCodeSet();
  
});

</script>