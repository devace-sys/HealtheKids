<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <appSettings>

    <add key="newManPageSubject"    value = "New Practi-Cal Announcements and/or Help Topics"/>
    <add key="newManPageHead"       value = "{0}:"/>
    <add key="newManPageBodyStart"  value = "Practi-Cal has published new announcements or help topics in SpEdCare that you will need to review.  These announcements or help topics may be related to a change in program policy, software updates or reminders of important program tasks."/>
    <add key="newManPageBodyEnd"    value = "Please login to your SpEdCare account and review the new announcements or help Items listed above.  If you have any further questions, please contact your assigned district consultant."/>
    
	  <add key="appNotice" value=""/>
    <add key="dbConnUsers" value="Data Source=localhost\SQLDEVELOPER;Initial Catalog=users;User Id=webuser;Password=plmitec98;"/>
    <add key="dbConnApp" value="Data Source=localhost\SQLDEVELOPER;Initial Catalog=SPEDMON;User Id=webuser;Password=plmitec98;"/>
    <add key="logFilePath" value="C:\spedmon\data\logs\apps\"/>
    <add key="rrLog" value="true"/>
    <add key="appVdir" value="/spedmon/"/>
    <!-- appName must match appName for all roles that wish to access this app -->
    <add key="appName" value="spedcare"/>
    <!-- <add key="appVersion" value="5.0"/> -->
    <add key="appEmailFrom" value="mail@practi-cal.com"/>
    <add key="appSMTPHost" value="mail.help4schools.com"/>
    <add key="appSMTPPort" value="25"/>
    <!-- appContact Must provide all members of Contact object -->
    <add key="appContact" value="{name:'Practi-Cal, Inc.', phone:'(909) 944-7798 or (888) 944-7798', fax:'(909) 481-7410', email:'lea@practi-cal.com', mail:'PO Box 981000 West Sacramento CA 95798-1000'}"/>    
  </appSettings>
  <!-- All emails are sent to a test folder -->
  <system.net>    
    <mailSettings>    
      <smtp deliveryMethod="SpecifiedPickupDirectory">
        <specifiedPickupDirectory pickupDirectoryLocation="C:\spedmon\data\test-email\" />
      </smtp>
    </mailSettings>
  </system.net>

</configuration>